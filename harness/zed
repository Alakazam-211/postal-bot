#!/usr/bin/env python3
"""Postal last-mile for Claude in Zed's integrated terminal.

claim / knock / resume. Zed has no public AppleScript inject API;
knock/resume use System Events on process Zed, then restore the previous
frontmost app (brief focus flash, then back). Resume opens the folder
with `zed -n` after `open -g`.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time

LOG = os.path.expanduser("~/.postal/zed-knock.log")
ZED_CLI = "/Applications/Zed.app/Contents/MacOS/cli"


def log(msg: str) -> None:
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(msg.rstrip() + "\n")
    except OSError:
        pass


def read_stdin() -> dict:
    raw = sys.stdin.read()
    return json.loads(raw) if raw.strip() else {}


def encode_project_dir(cwd: str) -> str:
    return os.path.expanduser("~/.claude/projects/") + cwd.replace("/", "-")


def claude_session_from_disk(cwd: str) -> str | None:
    cwd = os.path.abspath(cwd)
    hist = os.path.expanduser("~/.claude/history.jsonl")
    latest, latest_ts = None, -1
    if os.path.isfile(hist):
        try:
            with open(hist, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        d = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if d.get("project") != cwd:
                        continue
                    sid = (d.get("sessionId") or "").strip()
                    ts = d.get("timestamp") or 0
                    if sid and ts >= latest_ts:
                        latest, latest_ts = sid, ts
        except OSError:
            pass
    if latest:
        return latest
    proj = encode_project_dir(cwd)
    if not os.path.isdir(proj):
        return None
    files = []
    try:
        for name in os.listdir(proj):
            if name.endswith(".jsonl") and len(name) > 10:
                path = os.path.join(proj, name)
                files.append((os.path.getmtime(path), name[: -len(".jsonl")]))
    except OSError:
        return None
    if not files:
        return None
    files.sort()
    return files[-1][1]


def ancestor_named(pid: str, names: set[str]) -> bool:
    seen: set[str] = set()
    cur = pid
    while cur and cur not in ("0", "1") and cur not in seen:
        seen.add(cur)
        try:
            comm = subprocess.check_output(
                ["ps", "-p", cur, "-o", "comm="], text=True, stderr=subprocess.DEVNULL
            ).strip()
        except (OSError, subprocess.CalledProcessError):
            return False
        base = comm.rsplit("/", 1)[-1]
        if base in names or comm in names:
            return True
        try:
            ppid = subprocess.check_output(
                ["ps", "-p", cur, "-o", "ppid="], text=True, stderr=subprocess.DEVNULL
            ).strip()
        except (OSError, subprocess.CalledProcessError):
            return False
        cur = ppid
    return False


def live_claude_for_cwd(cwd: str, resume_id: str | None) -> tuple[str | None, str | None]:
    cwd = os.path.abspath(cwd)
    try:
        out = subprocess.check_output(["ps", "ax", "-o", "pid=,command="], text=True)
    except OSError:
        return None, None
    for line in out.splitlines():
        line = line.strip()
        if "claude" not in line or "bg-spare" in line or "bg-pty-host" in line:
            continue
        parts = line.split(None, 1)
        if not parts:
            continue
        pid = parts[0]
        cmd = parts[1] if len(parts) > 1 else ""
        if resume_id and resume_id not in cmd and "--resume" in cmd:
            continue
        try:
            env = subprocess.check_output(
                ["ps", "eww", "-p", pid], text=True, stderr=subprocess.DEVNULL
            )
        except (OSError, subprocess.CalledProcessError):
            continue
        if f"PWD={cwd}" not in env:
            continue
        idx = env.find("PWD=" + cwd)
        after = env[idx + 4 + len(cwd) : idx + 4 + len(cwd) + 1] if idx >= 0 else ""
        if after and after not in " \t\n":
            continue
        if not ancestor_named(pid, {"zed", "Zed"}):
            continue
        return pid, pid
    return None, None


def osascript(script: str, args: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["osascript", "-", *args],
        input=script,
        text=True,
        capture_output=True,
    )


INJECT_SCRIPT = r"""
on run argv
  set payload to item 1 of argv
  set prevFront to ""
  try
    tell application "System Events"
      set prevFront to name of first application process whose frontmost is true
    end tell
  end try
  tell application "System Events"
    tell process "zed"
      set frontmost to true
      delay 0.25
      keystroke "`" using control down
      delay 0.2
      keystroke payload
      delay 0.15
      keystroke return
      delay 0.25
      keystroke return
    end tell
  end tell
  if prevFront is not "" then
    try
      tell application "System Events"
        set frontmost of process prevFront to true
      end tell
    end try
  end if
  return "submitted"
end run
"""

RESUME_SCRIPT = r"""
on run argv
  set cmdline to item 1 of argv
  set prevFront to ""
  try
    tell application "System Events"
      set prevFront to name of first application process whose frontmost is true
    end tell
  end try
  tell application "System Events"
    tell process "zed"
      set frontmost to true
      delay 0.5
      keystroke "`" using control down
      delay 0.4
      keystroke cmdline
      delay 0.1
      keystroke return
    end tell
  end tell
  if prevFront is not "" then
    try
      tell application "System Events"
        set frontmost of process prevFront to true
      end tell
    end try
  end if
  return "spawned"
end run
"""


def cmd_claim(d: dict) -> None:
    cwd = os.path.abspath((d.get("cwd") or os.getcwd()).strip() or os.getcwd())
    claude_sid = claude_session_from_disk(cwd)
    want = (d.get("session_id") or "").strip()
    if want and len(want) == 36 and want.count("-") == 4:
        claude_sid = want
    if not claude_sid:
        print(json.dumps({"ok": False, "reason": "claim_failed: no Claude sessionId for cwd"}))
        sys.exit(1)
    pid, _ = live_claude_for_cwd(cwd, claude_sid)
    print(
        json.dumps(
            {
                "v": 1,
                "ok": True,
                "terminal": "zed",
                "session_id": claude_sid,
                "cwd": cwd,
                "live": bool(pid),
                "typ": "session",
                "launch": [
                    "claude",
                    "--dangerously-skip-permissions",
                    "--resume",
                    claude_sid,
                ],
                "pid": pid,
            }
        )
    )


def cmd_knock(d: dict) -> None:
    cwd = os.path.abspath((d.get("cwd") or os.getcwd()).strip() or os.getcwd())
    resume_id = (d.get("session_id") or "").strip()
    frm = (d.get("from") or "").strip()
    body = (d.get("body") or d.get("title") or "").strip()
    clean = "".join(c for c in body if c != "\x1b")
    line = " ".join(clean.split())
    payload = ("[from %s] %s" % (frm, line)) if frm else line
    pid, _ = live_claude_for_cwd(cwd, resume_id or None)
    if not pid:
        print(json.dumps({"ok": False, "reason": "not_live", "resume": True, "cwd": cwd}))
        sys.exit(1)
    r = osascript(INJECT_SCRIPT, [payload])
    log(
        "inject rc=%s out=%s err=%s"
        % (r.returncode, (r.stdout or "").strip(), (r.stderr or "").strip()[:300])
    )
    if r.returncode != 0 or "submitted" not in (r.stdout or ""):
        print(
            json.dumps(
                {
                    "ok": False,
                    "reason": "knock: osascript %s %s"
                    % (r.returncode, (r.stderr or r.stdout or "").strip()[:200]),
                }
            )
        )
        sys.exit(1)
    print(json.dumps({"ok": True, "injected": True, "pid": pid}))


def cmd_resume(d: dict) -> None:
    cwd = os.path.abspath((d.get("cwd") or os.getcwd()).strip() or os.getcwd())
    resume_id = (d.get("session_id") or "").strip() or (claude_session_from_disk(cwd) or "")
    if not resume_id:
        print(json.dumps({"ok": False, "reason": "resume: no Claude session id"}))
        sys.exit(1)
    pid, _ = live_claude_for_cwd(cwd, resume_id)
    if pid:
        print(json.dumps({"ok": True, "already": True, "pid": pid, "session_id": resume_id}))
        return
    subprocess.run(["open", "-g", "-a", "Zed"], check=False)
    time.sleep(0.6)
    zed = ZED_CLI if os.path.isfile(ZED_CLI) else "zed"
    r_open = subprocess.run([zed, "-n", cwd], capture_output=True, text=True)
    log("zed -n rc=%s err=%s" % (r_open.returncode, (r_open.stderr or "")[:200]))
    time.sleep(1.2)
    inner = "cd %s && exec claude --dangerously-skip-permissions --resume %s" % (
        json.dumps(cwd),
        resume_id,
    )
    r = osascript(RESUME_SCRIPT, [inner])
    log(
        "resume rc=%s out=%s err=%s"
        % (r.returncode, (r.stdout or "").strip(), (r.stderr or "").strip()[:300])
    )
    if r.returncode != 0:
        print(
            json.dumps(
                {
                    "ok": False,
                    "reason": "resume: osascript %s %s"
                    % (r.returncode, (r.stderr or "").strip()[:200]),
                }
            )
        )
        sys.exit(1)
    deadline = time.time() + 35
    pid = None
    while time.time() < deadline:
        pid, _ = live_claude_for_cwd(cwd, resume_id)
        if pid:
            break
        time.sleep(0.4)
    if not pid:
        print(json.dumps({"ok": False, "reason": "resume: claude PTY did not appear in Zed"}))
        sys.exit(1)
    time.sleep(1.6)
    print(json.dumps({"ok": True, "spawned": True, "pid": pid, "session_id": resume_id}))


def main() -> None:
    op = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        d = read_stdin()
    except json.JSONDecodeError as e:
        print(json.dumps({"ok": False, "reason": "bad json: %s" % e}))
        sys.exit(1)
    if op == "claim":
        cmd_claim(d)
    elif op == "knock":
        cmd_knock(d)
    elif op == "resume":
        cmd_resume(d)
    else:
        print(json.dumps({"ok": False, "reason": "usage: zed claim|knock|resume"}))
        sys.exit(2)


if __name__ == "__main__":
    main()
