{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/signup", "destination": "https://k2.dev/p/signup", "permanent": false },
    { "source": "/login", "destination": "https://k2.dev/p/login", "permanent": false }
  ],
  "rewrites": [
    { "source": "/account", "destination": "/account.html" },
    { "source": "/pay", "destination": "/pay.html" },
    { "source": "/paid", "destination": "/paid.html" }
  ],
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/grokbot-setup.sh",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/releases/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    }
  ]
}
